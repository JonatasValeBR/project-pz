# Copie para .env apenas para execução local. Nunca registre valores reais.
# Object storage: local hoje; no cluster trocar por gs://bucket/prefixo.
PGFN_ARTIFACT_STORE_URI=file:///opt/airflow/data
TOKEN=
REPORT_URL=
REPORT_ID=421
ENDPOINT_TRF3=
LINK_ACESSO_TRF3=
TRF3_LOGIN=
TRF3_SENHA=
PATH_RELATORIO=
PATH_PDF=
PATH_MANIFEST=
HTTP_TIMEOUT_SECONDS=30
SOAP_WSDL_TIMEOUT_SECONDS=30
SOAP_OPERATION_TIMEOUT_SECONDS=60
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
# error (seguro), first ou all. Confirmar a regra de negócio antes da produção.
INITIAL_DOCUMENT_POLICY=error
# Apenas para smoke test manual autorizado; use um processo sintético/homologado quando possível.
NUMERO_PROCESSO_TESTE=

# Scraping TRF1: credenciais próprias, sem reutilizar os nomes do TRF3.
ENDPOINT_TRF1=
TRF1_LOGIN=
TRF1_SENHA=
# Secret Base32 do TOTP. Não copie a imagem/QR Code para o projeto.
TRF1_TOTP_SECRET=
TRF1_REPORTS_URL=
TRF1_TIMEOUT_SECONDS=60
TRF1_HEADLESS=true

# Integra Service (fluxo de download de peças/processos)
INTEGRA_AMBIENTE=hom
INTEGRA_CLIENT_ID=
INTEGRA_CLIENT_SECRET=
INTEGRA_KC_BASE_URL=
INTEGRA_SERVICE_BASE_URL=
INTEGRA_KC_REALM=integra-realm
INTEGRA_JSON_PATH=data/integra_service/processos.json
INTEGRA_DOWNLOADS_DIR=
INTEGRA_RUNS_DIR=
INTEGRA_TIPO_DOCUMENTO_ALVO=PETIÇÃO INICIAL
INTEGRA_POLLING_INTERVAL=20
INTEGRA_POLLING_TIMEOUT=900
INTEGRA_TIMEOUT_PADRAO=60
INTEGRA_TIMEOUT_CEPH=180
INTEGRA_MAX_WORKERS=4
INTEGRA_LOG_LEVEL=INFO
INTEGRA_LOG_STDOUT=true
